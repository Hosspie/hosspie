# API 서버 URL - 프로덕션 NestJS 서버
EXPO_PUBLIC_API_URL="https://api.your-domain.com/api"

# Supabase 프로덕션
EXPO_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-production-anon-key"
