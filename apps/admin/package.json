{
  "private": true,
  "name": "@hosspie/admin",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start -c",
    "lint": "eslint --ext js,ts,tsx .",
    "test": "jest",
    "build": "expo export --output-dir ./build --platform all",
    "start": "expo start",
    "android": "DARK_MODE=media expo run:android",
    "ios": "DARK_MODE=media expo run:ios",
    "web": "DARK_MODE=media expo start --web",
    "eas-build-post-install": "pnpm run -w build:admin"
  },
  "dependencies": {
    "@apollo/client": "^4.1.6",
    "@expo/html-elements": "0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@roninoss/icons": "^0.0.4",
    "@shopify/flash-list": "2.0.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "expo": "~55.0.15",
    "expo-blur": "~55.0.14",
    "expo-dev-client": "~55.0.27",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.8",
    "expo-linking": "~55.0.13",
    "expo-navigation-bar": "~55.0.12",
    "expo-router": "~55.0.12",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "~55.0.18",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.15",
    "expo-web-browser": "~55.0.14",
    "graphql": "^16.12.0",
    "lucide-react-native": "^0.525.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.62.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-svg-transformer": "^1.5.1",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "yup": "^1.7.0"
  },
  "devDependencies": {
    "@hosspie/database": "workspace:*",
    "@hosspie/design-system": "workspace:*",
    "@hosspie/eslint-config": "workspace:*",
    "@hosspie/services": "workspace:*",
    "@hosspie/types": "workspace:*",
    "@hosspie/typescript-config": "workspace:*",
    "@hosspie/ui-config": "workspace:*",
    "@hosspie/utils": "workspace:*",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.14",
    "jest": "^29.2.1",
    "jest-expo": "~55.0.16",
    "jscodeshift": "0.15.2",
    "typescript": "^5.8.3"
  },
  "eslintConfig": {
    "extends": "@hosspie/eslint-config",
    "ignorePatterns": [
      "node_modules",
      "build",
      ".expo",
      ".expo-shared"
    ],
    "overrides": [
      {
        "files": [
          "*.js"
        ],
        "env": {
          "node": true
        }
      }
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets"
      ]
    }
  },
  "jest": {
    "preset": "jest-expo"
  }
}
