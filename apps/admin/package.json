{
  "private": true,
  "name": "@hosspie/admin",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start -c",
    "lint": "eslint --ext js,ts,tsx .",
    "test": "jest",
    "build": "expo export --output-dir ./build --platform all",
    "start": "expo start",
    "android": "DARK_MODE=media expo run:android",
    "ios": "DARK_MODE=media expo run:ios",
    "web": "DARK_MODE=media expo start --web",
    "eas-build-post-install": "pnpm run -w build:admin"
  },
  "dependencies": {
    "@expo/html-elements": "0.4.2",
    "@expo/vector-icons": "^14.1.0",
    "@react-native/gradle-plugin": "^0.80.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@roninoss/icons": "^0.0.4",
    "@shopify/flash-list": "1.7.6",
    "babel-plugin-module-resolver": "^5.0.2",
    "expo": "~53.0.23",
    "expo-blur": "~14.1.4",
    "expo-constants": "~17.1.5",
    "expo-dev-client": "~5.2.1",
    "expo-font": "~13.3.1",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.1",
    "expo-linking": "~7.1.4",
    "expo-navigation-bar": "~4.2.8",
    "expo-router": "~5.1.7",
    "expo-secure-store": "~14.2.4",
    "expo-splash-screen": "~0.30.8",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.4",
    "expo-system-ui": "~5.0.11",
    "expo-web-browser": "~14.2.0",
    "lucide-react-native": "^0.525.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.62.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.5",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-svg-transformer": "^1.5.1",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5",
    "yup": "^1.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@hosspie/design-system": "workspace:*",
    "@hosspie/eslint-config": "workspace:*",
    "@hosspie/services": "workspace:*",
    "@hosspie/typescript-config": "workspace:*",
    "@hosspie/ui-config": "workspace:*",
    "@hosspie/utils": "workspace:*",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.0.14",
    "jest": "^29.2.1",
    "jest-expo": "~53.0.10",
    "jscodeshift": "0.15.2",
    "typescript": "^5.8.3"
  },
  "eslintConfig": {
    "extends": "@hosspie/eslint-config",
    "ignorePatterns": [
      "node_modules",
      "build",
      ".expo",
      ".expo-shared"
    ],
    "overrides": [
      {
        "files": [
          "*.js"
        ],
        "env": {
          "node": true
        }
      }
    ]
  },
  "jest": {
    "preset": "jest-expo"
  }
}
