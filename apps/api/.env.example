# ============================================
# Hosspie API - Environment Variables
# ============================================
# 이 파일을 복사하여 .env.development.local 또는 .env.production.local 을 생성하세요
# cp .env.example .env.development.local

# ============================================
# 기본 설정
# ============================================
NODE_ENV=development
PORT=4000

# ============================================
# Supabase / PostgreSQL 데이터베이스
# ============================================
# 📚 참고: https://supabase.com/docs/guides/integrations/prisma

# Prisma에서 사용하는 메인 연결 URL (Connection Pooler - Transaction Mode)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Direct 연결 URL (마이그레이션용 - Session Mode)
# Supabase는 PgBouncer를 사용하므로 마이그레이션 시 직접 연결 필요
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ============================================
# Supabase 설정
# ============================================
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ============================================
# CORS 설정
# ============================================
CORS_ORIGIN="*"

# ============================================
# JWT 설정 (인증 구현 시 사용)
# ============================================
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="1d"
