{
  "private": true,
  "name": "@hosspie/monorepo",
  "scripts": {
    "dev": "turbo dev",
    "dev:admin": "turbo dev --filter=\"{./apps/admin}...\"",
    "lint": "turbo lint",
    "test": "turbo test",
    "build": "turbo build",
    "build:admin": "turbo build --filter=\"...{./apps/admin}\""
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "turbo": "^1.13.4",
    "typescript": "^5.9.2"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "es5",
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
