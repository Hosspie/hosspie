{
  "private": true,
  "name": "@hosspie/design-system",
  "version": "1.0.0",
  "exports": {
    "./components/*": "./src/components/*",
    "./organisms/*": "./src/organisms/*",
    "./hooks/*": "./src/hooks/*",
    "./providers/*": "./src/providers/*",
    "./config": "./src/config/tamagui.config.ts"
  },
  "description": "Hosspie design system built on Tamagui",
  "license": "MIT",
  "scripts": {
    "lint": "eslint --ext js,ts,tsx ."
  },
  "eslintConfig": {
    "extends": "@hosspie/eslint-config",
    "ignorePatterns": [
      "node_modules"
    ]
  },
  "dependencies": {
    "tamagui": "2.0.0-rc.16",
    "@tamagui/config": "2.0.0-rc.16",
    "@tamagui/animations-react-native": "2.0.0-rc.16",
    "@tamagui/font-inter": "2.0.0-rc.16",
    "@tamagui/shorthands": "2.0.0-rc.16",
    "@tamagui/themes": "2.0.0-rc.16",
    "react-native-reanimated": "~3.16.0"
  },
  "devDependencies": {
    "@hosspie/eslint-config": "workspace:*",
    "@tamagui/babel-plugin": "2.0.0-rc.16"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
